# --- Mistral OCR ---
MISTRAL_API_KEY=colle_ta_cle_mistral_ici
MISTRAL_CHAT_MODEL=mistral-small-latest

# --- Odoo (JSON-RPC) ---
ODOO_JSONRPC_URL=https://odooee.alphamotors-cameroun.com/jsonrpc
ODOO_DB=alpha_motors
ODOO_USER=service.it@alphamotors-cameroun.com
ODOO_PASSWORD=colle_le_mot_de_passe_ou_cle_api_ici

# --- Modeles Odoo Studio (a creer, un par type de document) ---
ODOO_MODEL_RDV=x_suivi_rdv_ocr
ODOO_MODEL_APPEL=x_fiche_appel_scan
ODOO_MODEL_APPEL_LIGNE=x_ligne_d_appel

# --- Etiquette "scan" + statut (champs a creer dans Odoo Studio si absents) ---
# ODOO_TAG_FIELD_RDV / ODOO_TAG_FIELD_APPEL : nom technique du champ etiquette.
#   Peut etre un champ Tags (many2many), texte ou case a cocher, detecte automatiquement.
ODOO_TAG_FIELD_RDV=x_studio_etiquette
ODOO_TAG_FIELD_APPEL=x_studio_etiquette

# ODOO_STATUS_FIELD_RDV / ODOO_STATUS_FIELD_APPEL : champ Selection a creer dans
# Studio avec au minimum les cles techniques : nouveau / a_rappeler / contacte / traite
ODOO_STATUS_FIELD_RDV=x_studio_status
ODOO_STATUS_FIELD_APPEL=x_studio_status

PORT=8094
